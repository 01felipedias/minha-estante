<%- include("partials/header") %>

<article class="overflow-hidden rounded-3xl bg-white shadow-xl">
  <section class="grid items-center gap-8 p-8 md:grid-cols-2 md:p-14">
    <hgroup>
      <p class="mb-3 font-bold uppercase tracking-widest text-amber-600">Biblioteca pessoal</p>
      <h2 class="text-4xl font-black leading-tight text-stone-900 md:text-6xl">Cada livro abre um novo mundo.</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-stone-600">Cadastre suas leituras, acompanhe o progresso e mantenha sua estante sempre organizada.</p>
      <a class="mt-7 inline-block rounded-xl bg-stone-900 px-6 py-3 font-bold text-white shadow hover:bg-amber-600" href="/livros">Acessar minha estante</a>
    </hgroup>
    <figure class="rounded-3xl bg-amber-100 p-10 text-center" aria-label="Ilustração de livros">
      <span class="block text-9xl" role="img" aria-label="Livros empilhados"></span>
      <figcaption class="mt-5 font-medium text-stone-600">Organize hoje. Leia sempre.</figcaption>
    </figure>
  </section>
</article>

<%- include("partials/footer") %>
